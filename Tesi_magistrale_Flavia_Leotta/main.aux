\@writefile{lof}{\contentsline {figure}{\numberline {2.8}{\ignorespaces \justifying  {\footnotesize  \textit  {\textbf  {Stacks: \texttt  {denovo\_map.pl} pipeline.} \footnotesize  {Full view of the Stacks: \texttt  {denovo\_map.pl} pipeline from Catchen \textit  {et al.} (2011) \blx@tocontentsinit {0}\parencite {catchenStacksBuildingGenotyping2011}. It starts with (A) \texttt  {ustacks}, which, for each individual, forms stacks of minimum $m$ reads that match exactly, (B) breaks down each stack into k-mers and stores them in a dictionary (C). Then matches secondary reads (D) based on a certain number $M$ of mismatches to increases stack depth. Each locus at each nucleotide position is checked for polymorphisms and a consensus sequence is called (E). (F) \texttt  {cstacks} then loads all stacks into a Catalog to create a set of all possible loci, merging those that have at maximum $n$ mismatches between each other. (G) \texttt  {sstacks} matches map cross progeny against the Catalog to determine the haplotypes at each locus in every individual in the cross. \texttt  {populations}, at the end, computes genetic populations metrics based on the SNPs called and a population map provided.}}}}}{20}{figure.caption.18}\protected@file@percent }
\newlabel{fig:pipeline_denovo}{{2.8}{20}{\justifying {\footnotesize \textit {\textbf {Stacks: \texttt {denovo\_map.pl} pipeline.} \footnotesize {Full view of the Stacks: \texttt {denovo\_map.pl} pipeline from Catchen \textit {et al.} (2011) \parencite {catchenStacksBuildingGenotyping2011}. It starts with (A) \texttt {ustacks}, which, for each individual, forms stacks of minimum $m$ reads that match exactly, (B) breaks down each stack into k-mers and stores them in a dictionary (C). Then matches secondary reads (D) based on a certain number $M$ of mismatches to increases stack depth. Each locus at each nucleotide position is checked for polymorphisms and a consensus sequence is called (E). (F) \texttt {cstacks} then loads all stacks into a Catalog to create a set of all possible loci, merging those that have at maximum $n$ mismatches between each other. (G) \texttt {sstacks} matches map cross progeny against the Catalog to determine the haplotypes at each locus in every individual in the cross. \texttt {populations}, at the end, computes genetic populations metrics based on the SNPs called and a population map provided.}}}}{figure.caption.18}{}}
