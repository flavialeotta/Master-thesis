\@writefile{lof}{\contentsline {figure}{\numberline {2.8}{\ignorespaces \justifying  {\footnotesize  \textit  {\textbf  {Comparison of Haldane’s and Kosambi’s mapping functions.} \footnotesize  {The red line shows a linear relationship between map distance (in cM) and recombination rate ($R$), while the black and the blue one show how the map distance grows exponentially with the recombination rate following, respectively, Haldane's (\ref {haldane}) and Kosambi's (\ref {kosambi}) functions. Haldane's assumes there no interference, namely the effect of a crossover in one region on the likelihood of a crossover in another one \blx@tocontentsinit {0}\cite {huehnRandomVariabilityMap2010}. There's no direct linear relationship between units of genetic distances in centimorgan (cM) and physical distances in kilobase pairs (kb), and depends solely on the organism in the study \blx@tocontentsinit {0}\cite {semagnPrinciplesRequirementsProspects}.}}}}}{20}{figure.caption.25}\protected@file@percent }
\newlabel{fig:haldane-kosambi}{{2.8}{20}{\justifying {\footnotesize \textit {\textbf {Comparison of Haldane’s and Kosambi’s mapping functions.} \footnotesize {The red line shows a linear relationship between map distance (in cM) and recombination rate ($R$), while the black and the blue one show how the map distance grows exponentially with the recombination rate following, respectively, Haldane's (\ref {haldane}) and Kosambi's (\ref {kosambi}) functions. Haldane's assumes there no interference, namely the effect of a crossover in one region on the likelihood of a crossover in another one \cite {huehnRandomVariabilityMap2010}. There's no direct linear relationship between units of genetic distances in centimorgan (cM) and physical distances in kilobase pairs (kb), and depends solely on the organism in the study \cite {semagnPrinciplesRequirementsProspects}.}}}}{figure.caption.25}{}}
