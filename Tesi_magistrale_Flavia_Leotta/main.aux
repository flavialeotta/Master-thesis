\@writefile{lof}{\contentsline {figure}{\numberline {3.15}{\ignorespaces \justifying  {\footnotesize  \textit  {\textbf  {\textit  {Solanum} genus samples' PCA plots.} \footnotesize  {PCA plots of either (a) all \textit  {Solanum} genus samples in the study or (b, c, d) only landraces and \textit  {S. tuberosum} subsp. \textit  {andigenum} as outgroup. Please refer to the legend to distinguish the samples: (i) black: wild/ancient species, (ii) green: \textit  {S. tuberosum} subsp. \textit  {andigenum}, (iii) cyan: obsolete landraces (Bossico and Shilpario), (iv) light blue: Starleggia Bianca, (v) blue: white peel landraces close to commercial Kennebec, (vi) red: red peel landraces close to commercial Desiree, (vii) yellow: hybrid landrace Bianca.}}}}}{63}{figure.caption.59}\protected@file@percent }
