t, given=Bas, prefix=te, useprefix=true and Goverse, Aska and family=Ham, given=Roeland C. H. J., prefix=van, useprefix=true and Visser, Richard G. F. and {The Potato Genome Sequencing Consortium} and {The Potato Genome Consortium (Participants are listed alphabetically by institution.)} and {BGI-Shenzhen} and {Cayetano Heredia University} and {Central Potato Research Institute} and {Centre Bioengineering RAS} and CGR-CMM, Universidad de Chile and College of Life Sciences, University of Dundee and High Technology Research Center, Shandong Academy of Agricultural Sciences and {Huazhong Agriculture University} and {Hunan Agricultural University} and {Imperial College London} and {Instituto de Investigaciones Agropecuarias} and {Institute of Biochemistry \& Biophysics} and Institute of Vegetables \& Flowers, Chinese Academy of Agricultural Sciences and {International Potato Center} and Italian National Agency for New Technologies, Energy \& Sustainable Development and {J Craig Venter Institute} and Laboratorio de Agrobiotecnología, Instituto Nacional de Tecnología Agropecuaria and Laboratorio de Biología de Sistemas, Universidad Nacional de LaPlata and {Michigan State University} and {Scottish Crop Research Institute} and {Teagasc Crops Research Centre} and {The New Zealand Institute for Plant \& Food Research Ltd} and {University of Aalborg} and {University of Wisconsin} and {Virginia Polytechnic Institute \& State University} and {Wageningen University \& Research Centre}},
  date = {2011-07},
