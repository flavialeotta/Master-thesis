@article{salgotraGeneticDiversityConservation2023,
  title = {Genetic {{Diversity}}, {{Conservation}}, and {{Utilization}} of {{Plant Genetic Resources}}},
  author = {Salgotra, Romesh Kumar and Chauhan, Bhagirath Singh},
  date = {2023-01-09},
  journaltitle = {Genes},
  shortjournal = {Genes (Basel)},
  volume = {14},
