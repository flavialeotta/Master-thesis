@article{loaizaReviewGeneticDiversity2012,
  title = {Review of Genetic Diversity in Malaria Vectors ({{Culicidae}}: {{Anophelinae}})},
  shorttitle = {Review of Genetic Diversity in Malaria Vectors ({{Culicidae}}},
  author = {Loaiza, J. R. and Bermingham, E. and Sanjur, O. I. and Scott, M. E. and Bickersmith, S. A. and Conn, J. E.},
