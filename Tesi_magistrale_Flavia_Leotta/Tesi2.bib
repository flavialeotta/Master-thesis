@article{habelBurdenGeneticDiversity2012,
  title = {The Burden of Genetic Diversity},
  author = {Habel, Jan Christian and Schmitt, Thomas},
  date = {2012-03-01},
  journaltitle = {Biological Conservation},
  shortjournal = {Biological Conservation},
  volume = {147},
  number = {1},
